enterprise-toolbar-button =
    .label = { -brand-short-name }
    .tooltiptext = { -brand-short-name }

enterprise-panel =
    .label = { -brand-short-name } panneau
    .tooltiptext = { -brand-short-name } panneau
enterprise-panel-alert = Activité sous surveillance
enterprise-panel-information = Vous êtes connectés avec un navigateur géré par l’entreprise. Certaines activités de votre navigation pourraient être surveillées par votre société pour des raisons de sécurité et de confirmité.
enterprise-panel-learn-more = En savoir plus
enterprise-panel-sign-out-btn =
    .label = Sign out…

enterprise-signout-prompt-title = Déconnexion de { -brand-short-name }?
enterprise-signout-prompt-message = Vous vous déconnectez de votre navigateur { -brand-short-name }. Pour l’utiliser de nouveau, vous devrez vous ré-authentifier via le fournisseur d’authentification de votre société..
enterprise-signout-prompt-checkbox-label = Afficher ce message lors de la déconnexion.
enterprise-signout-prompt-primary-btn-label = Déconnexion
